+package com.reactnativecommunity.webview;
+
+import android.content.Context;
+import android.webkit.WebResourceResponse;
+
+import java.io.BufferedReader;
+import java.io.ByteArrayInputStream;
+import java.io.InputStreamReader;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Lwedflix: the desktop app's ad and tracker blocklist (electron/adblock.js),
+ * applied to every request a WebView makes outside its top frame, as the
+ * desktop's session.webRequest.onBeforeRequest does. The list is written to
+ * the APK's assets by mobile/plugins/withAdBlock.js. A blocked domain covers
+ * its subdomains.
+ */
+final class LwfAdBlock {
+    private static final String ASSET = "lwf-blocked-domains.txt";
+    private static volatile Set<String> domains = null;
+
+    private LwfAdBlock() {}
+
+    private static Set<String> load(Context context) {
+        Set<String> loaded = domains;
+        if (loaded != null) return loaded;
+        synchronized (LwfAdBlock.class) {
+            if (domains != null) return domains;
+            Set<String> set = new HashSet<>();
+            try (BufferedReader reader = new BufferedReader(new InputStreamReader(context.getAssets().open(ASSET), "UTF-8"))) {
+                String line;
+                while ((line = reader.readLine()) != null) {
+                    line = line.trim().toLowerCase();
+                    if (!line.isEmpty()) set.add(line);
+                }
+            } catch (Exception e) {
+                // No list in this build: block nothing rather than fail.
+            }
+            domains = Collections.unmodifiableSet(set);
+            return domains;
+        }
+    }
+
+    static boolean isBlocked(Context context, String host) {
+        if (host == null) return false;
+        Set<String> list = load(context);
+        String h = host.toLowerCase();
+        if (h.endsWith(".")) h = h.substring(0, h.length() - 1);
+        while (true) {
+            if (list.contains(h)) return true;
+            int dot = h.indexOf('.');
+            if (dot == -1) return false;
+            h = h.substring(dot + 1);
+        }
+    }
+
+    static WebResourceResponse blocked() {
+        return new WebResourceResponse("text/plain", "utf-8", 403, "Blocked", Collections.<String, String>emptyMap(), new ByteArrayInputStream(new byte[0]));
+    }
+}
